{
  "name": "@teovo/db",
  "version": "0.1.1",
  "description": "Teovo Postgres tables, migrations and storage adapters",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teovo-dev/teovo.git",
    "directory": "packages/db"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/trials"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@teovo/server": "^0.1.1",
    "ai": "^7.0.183"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  },
  "homepage": "https://github.com/teovo-dev/teovo/tree/main/packages/db#readme",
  "bugs": {
    "url": "https://github.com/teovo-dev/teovo/issues"
  },
  "keywords": [
    "ai",
    "assistant",
    "postgres",
    "supabase",
    "migrations",
    "in-app-assistant"
  ],
  "engines": {
    "node": ">=20"
  }
}
