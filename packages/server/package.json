{
  "name": "@teovo/server",
  "version": "0.1.1",
  "description": "Teovo server handler: the assistant's tool loop, cards, limits and logs",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teovo-dev/teovo.git",
    "directory": "packages/server"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./workers-ai": {
      "types": "./dist/workers-ai.d.ts",
      "import": "./dist/workers-ai.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/trials"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.39",
    "ai": "^7.0.183",
    "zod": "^4.6.7"
  },
  "homepage": "https://github.com/teovo-dev/teovo/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/teovo-dev/teovo/issues"
  },
  "keywords": [
    "ai",
    "assistant",
    "agent",
    "llm",
    "tools",
    "vercel-ai-sdk",
    "in-app-assistant"
  ],
  "engines": {
    "node": ">=20"
  }
}
