{
  "name": "@teovo/react",
  "version": "0.1.2",
  "description": "Teovo React panel and screen-context hooks",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teovo-dev/teovo.git",
    "directory": "packages/react"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/trials"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.188",
    "ai": "^7.0.183"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "homepage": "https://github.com/teovo-dev/teovo/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/teovo-dev/teovo/issues"
  },
  "keywords": [
    "ai",
    "assistant",
    "chat",
    "react",
    "llm",
    "in-app-assistant"
  ],
  "engines": {
    "node": ">=20"
  }
}
