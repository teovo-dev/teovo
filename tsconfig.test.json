{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "paths": {
      "@teovo/server": [
        "./packages/server/src/index.ts"
      ],
      "@teovo/react": [
        "./packages/react/src/index.ts"
      ],
      "@teovo/db": [
        "./packages/db/src/index.ts"
      ],
      "teovo": [
        "./packages/cli/src/cli.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.test.tsx"
  ]
}
