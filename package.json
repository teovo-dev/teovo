{
  "name": "teovo-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @teovo/server -w @teovo/react -w @teovo/db -w teovo",
    "typecheck": "npm run build && tsc -p tsconfig.test.json && tsc -p examples/shop/tsconfig.json && tsc -p examples/workers-ai-check/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
